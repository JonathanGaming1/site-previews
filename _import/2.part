<body>
<a class="skip" href="#main">דלג לתוכן הראשי</a>
<div class="progress" aria-hidden="true"><i id="progressBar"></i></div>
<div class="bg" aria-hidden="true">
  <div class="bg-glow"></div>
  <div class="bg-spot" id="bgSpot"></div>
  <div class="bg-grain"></div>
  <div class="bg-vig"></div>
</div>
<div class="cur" id="cur" aria-hidden="true"></div>
<div class="cur-ring" id="curRing" aria-hidden="true"></div>

<!-- ================= NAV ================= -->
<header class="nav" id="nav">
  <div class="nav-in">
    <a class="brand" href="#top" aria-label="חזרה לראש העמוד">
      <span class="brand-mark" id="brandMark">א</span>
      <span class="brand-txt">
        <b data-t="businessName">העסק שלכם</b>
        <i data-t="category">עסק מקומי</i>
      </span>
    </a>
    <nav class="nav-links" aria-label="ניווט ראשי">
      <a href="#services">שירותים</a>
      <a href="#about">אודות</a>
      <a href="#work">עבודות</a>
      <a href="#process">תהליך</a>
      <a href="#faq">שאלות</a>
    </nav>
    <div class="nav-act">
      <span class="pv" id="previewNote" hidden>תצוגה מקדימה</span>
      <a class="btn btn-quiet btn-sm" id="navCall" href="tel:">התקשרו</a>
      <a class="btn btn-primary btn-sm magnet" id="navCta" href="#contact">דברו איתנו</a>
      <button class="burger" id="burger" type="button" aria-label="פתיחת תפריט" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true">
  <a class="m-link" href="#services">שירותים<span>01</span></a>
  <a class="m-link" href="#about">אודות<span>02</span></a>
  <a class="m-link" href="#work">עבודות<span>03</span></a>
  <a class="m-link" href="#process">תהליך<span>04</span></a>
  <a class="m-link" href="#faq">שאלות<span>05</span></a>
  <a class="m-link" href="#contact">צור קשר<span>06</span></a>
  <div class="menu-foot">
    <a class="btn btn-primary" id="menuCta" href="#contact">דברו איתנו</a>
    <a class="btn btn-ghost" id="menuCall" href="tel:">התקשרו</a>
  </div>
</div>

<main id="main">

<!-- ================= HERO ================= -->
<section class="hero" id="top">
  <div class="hero-in">
    <span class="hero-pill reveal in"><b id="heroBadge">עסק מקומי</b><span id="heroKicker">אנחנו כאן בשבילכם</span></span>
    <h1 id="heroTitle">
      <span class="ln"><span id="hl1" style="--d:.06s">חוויית לקוח</span></span>
      <span class="ln"><span id="hl2" class="accent" style="--d:.18s">מהשורה הראשונה</span></span>
    </h1>
    <p class="lede reveal in" id="heroSub" style="--d:.28s">אנחנו עושים את העבודה בשבילכם, ברמה של מותג גדול — עם תשומת לב לפרט, זמני תגובה קצרים ותוצאה שנראית טוב.</p>
    <div class="hero-cta reveal in" style="--d:.36s">
      <a class="btn btn-primary magnet" id="heroPrimary" href="#contact">דברו איתנו</a>
      <a class="btn btn-ghost magnet" id="heroGhost" href="#work">לעבודות שלנו</a>
    </div>
    <div class="hero-meta reveal in" style="--d:.44s">
      <span class="rate" id="rateChip" hidden>
        <span class="stars" id="rateStars" aria-hidden="true"></span>
        <b id="rateVal">5.0</b>
        <span id="rateCount">ביקורות בגוגל</span>
      </span>
      <span class="dot" id="rateDot" hidden></span>
      <span id="metaCity">תל אביב</span>
      <span class="dot"></span>
      <span id="metaCat">עסק מקומי</span>
    </div>

    <div class="hero-media reveal in" id="heroMedia" style="--d:.5s">
      <div class="hero-shot" id="heroShot">
        <img id="heroImg" src="" alt="" loading="eager" decoding="async">
      </div>
      <div class="hm-chip tl" id="hmTop">
        <span class="ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M3 12h18"/></svg>
        </span>
        <span><small id="hmTopSmall">פרויקט נבחר</small><b id="hmTopText">2026</b></span>
      </div>
      <div class="hm-chip br" id="hmBot">
        <span class="ic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.4-7-10a7 7 0 1114 0c0 5.6-7 10-7 10z"/><circle cx="12" cy="11" r="2.4"/></svg>
        </span>
        <span><small id="hmBotSmall">מיקום</small><b id="hmBotText">תל אביב</b></span>
      </div>
    </div>

    <div class="hero-scroll" aria-hidden="true"><i></i><span>גלילה</span></div>
  </div>
</section>

<!-- ================= MARQUEE ================= -->
<div class="mq" aria-hidden="true">
  <div class="mq-row mq-a"><div class="mq-set" id="mqA"></div></div>
  <div class="mq-row mq-b"><div class="mq-set" id="mqB"></div></div>
</div>

<!-- ================= SERVICES ================= -->
<section class="sec" id="services">
  <div class="wrap">
    <div class="svcs-grid">
      <div class="svcs-visual reveal">
        <div class="vis-stack" id="visStack"></div>
        <div class="vis-dots" id="visDots" aria-hidden="true"></div>
      </div>
      <div class="svcs-body">
        <div class="sec-head reveal">
          <span class="eyebrow"><span class="num">01</span> שירותים</span>
          <h2 class="h2" id="svcTitle">מה אנחנו <span class="grad">עושים</span></h2>
          <p class="lede" id="svcIntro">שלושה מסלולים שנבנו כדי להתאים בדיוק למה שאתם צריכים — בלי יותר ובלי פחות.</p>
        </div>
        <div id="svcList"></div>
      </div>
    </div>
  </div>
</section>

<!-- ================= ABOUT / BENTO ================= -->
<section class="sec sec-line" id="about">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="num">02</span> אודות</span>
      <h2 class="h2" id="aboutTitle">הכל מתחיל ב<span class="grad">אנשים</span></h2>
    </div>
    <div class="bento">
      <article class="card b-about spot reveal">
        <div class="shot"><img id="aboutImg" src="" alt="" loading="lazy" decoding="async"></div>
        <div class="body">
          <h3 id="aboutHead">סיפור קצר על העסק</h3>
          <p id="aboutText">אנחנו מאמינים שעבודה טובה לא צריכה להיות מסובכת. מקשיבים, מתכננים בקפידה ומבצעים בזמן — עם יחס אישי בכל שלב.</p>
        </div>
      </article>
      <article class="card b-rate reveal" style="--d:.06s" id="rateCard">
        <div>
          <span class="eyebrow" style="font-size:11px">דירוג</span>
          <div class="big" id="rateBig">5.0<sup>★</sup></div>
          <small id="rateSmall">מבוסס על ביקורות אמיתיות</small>
        </div>
        <div class="stars" id="rateStars2" aria-hidden="true"></div>
      </article>
      <article class="card b-feat spot reveal" style="--d:.1s">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.6L20 10.8l-5.8 2.2L12 18.6l-2.2-5.6L4 10.8l5.8-2.2z"/><path d="M18.5 16.5l.9 2.2 2.1.8-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.8z"/></svg></span>
        <h4>עבודה ברמה של מותג</h4>
        <p>כל פרט מתוכנן מראש: טיפוגרפיה, מרווחים, תנועה. התוצאה נראית יקרה — גם בתקציב סביר.</p>
      </article>
      <article class="card b-stat spot reveal" style="--d:.14s">
        <div class="n"><span id="statNum">0</span><span id="statSuf">+</span></div>
        <p id="statLabel">פרויקטים שהושלמו בשנה האחרונה</p>
      </article>
      <article class="card b-feat spot reveal" style="--d:.18s">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12z"/></svg></span>
        <h4>מהירות שהיא חלק מהשירות</h4>
        <p>מענה באותו יום, לוחות זמנים ברורים ועדכונים שוטפים. אתם תמיד יודעים מה קורה ומה הלאה.</p>
      </article>
    </div>
  </div>
</section>

<!-- ================= GALLERY ================= -->
<section class="gal" id="work">
  <div class="gal-pin">
    <div class="gal-head">
      <div class="sec-head reveal">
        <span class="eyebrow"><span class="num">03</span> עבודות</span>
        <h2 class="h2" id="workTitle">עבודות <span class="grad">נבחרות</span></h2>
        <p class="lede" id="workIntro">מדגם מתוך פרויקטים אחרונים. לחיצה על תמונה פותחת אותה בגודל מלא.</p>
      </div>
      <span class="gal-count"><b id="galNow">01</b> / <span id="galTotal">03</span></span>
    </div>
    <div class="gal-view" id="galView">
      <div class="gal-track" id="galTrack"></div>
    </div>
    <div class="gal-bar">
      <span class="gal-hint">גללו</span>
      <div class="rail"><i id="galFill"></i></div>
      <span class="gal-hint">הצידה</span>
    </div>
  </div>
</section>

<!-- ================= PROCESS ================= -->
<section class="sec sec-line" id="process">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow"><span class="num">04</span> תהליך</span>
      <h2 class="h2" id="procTitle">שלושה שלבים, <span class="grad">אפס הפתעות</span></h2>
      <p class="lede">מהשיחה הראשונה ועד למסירה — תהליך ברור, מתועד ומדויק.</p>
    </div>
    <div class="proc-grid">
      <div class="proc-rail" aria-hidden="true"><i id="procFill"></i></div>
      <div id="procList" style="display:contents"></div>
    </div>
  </div>
</section>

<!-- ================= FAQ ================= -->
<section class="sec sec-line" id="faq">
  <div class="wrap">
    <div class="faq-grid">
      <div class="faq-side">
        <div class="sec-head reveal">
          <span class="eyebrow"><span class="num">05</span> שאלות</span>
          <h2 class="h2" id="faqTitle">שאלות <span class="grad">נפוצות</span></h2>
          <p class="lede">לא מצאתם תשובה? כתבו לנו בוואטסאפ ונחזור אליכם באותו יום.</p>
          <a class="btn btn-ghost" id="faqWa" href="#" style="margin-top:22px">לשאול בוואטסאפ</a>
        </div>
      </div>
      <div class="acc" id="accList"></div>
    </div>
  </div>
</section>

<!-- ================= CTA ================= -->
<section class="cta-sec" id="contact">
  <div class="wrap">
    <div class="cta-card">
      <span class="eyebrow reveal" style="justify-content:center">06 צור קשר</span>
      <h2 class="reveal" id="ctaTitle" style="--d:.06s">בואו נדבר על <b>הפרויקט שלכם</b></h2>
      <p class="lede reveal" id="ctaText" style="--d:.12s">ספרו לנו מה אתם צריכים. נחזור אליכם עם כיוון ראשוני והערכה — בלי התחייבות.</p>
      <div class="cta-actions reveal" style="--d:.18s">
        <a class="btn btn-primary magnet" id="waBtn" href="#">וואטסאפ</a>
        <a class="btn btn-ghost magnet" id="telBtn" href="tel:">התקשרו אליי</a>
      </div>
      <div class="cta-rows reveal" style="--d:.24s">
        <a class="crow" id="telRow" href="tel:">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 3.5h2.6l1.3 4-2 1.4a12 12 0 005.6 5.6l1.4-2 4 1.3v2.6a2.5 2.5 0 01-2.7 2.5A16.5 16.5 0 014.1 6.2 2.5 2.5 0 016.6 3.5z"/></svg></span>
          <span><small>טלפון</small><b id="telText">050-0000000</b></span>
          <button class="copy" id="copyPhone" type="button" aria-label="העתקת מספר הטלפון">העתקה</button>
        </a>
        <a class="crow" id="addrRow" href="#">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.4-7-10a7 7 0 1114 0c0 5.6-7 10-7 10z"/><circle cx="12" cy="11" r="2.4"/></svg></span>
          <span><small>כתובת</small><b id="contactAddr">תל אביב</b></span>
        </a>
        <div class="crow">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg></span>
          <span><small>זמני מענה</small><b>א׳–ה׳ · 9:00–19:00</b></span>
        </div>
      </div>
    </div>
  </div>
</section>
</main>

<!-- ================= FOOTER ================= -->
<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a class="brand" href="#top" aria-label="חזרה לראש העמוד">
          <span class="brand-mark" id="footMark">א</span>
          <span class="brand-txt"><b data-t="businessName">העסק שלכם</b><i data-t="city">תל אביב</i></span>
        </a>
        <p id="footBlurb">חוויית לקוח מהשורה הראשונה, עם תשומת לב לפרט.</p>
      </div>
      <div class="foot-col">
        <h4>ניווט</h4>
        <ul>
          <li><a href="#services">שירותים</a></li>
          <li><a href="#about">אודות</a></li>
          <li><a href="#work">עבודות</a></li>
          <li><a href="#process">תהליך</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>מידע</h4>
        <ul>
          <li><a href="#faq">שאלות נפוצות</a></li>
          <li><a href="#contact">יצירת קשר</a></li>
          <li><a href="#top">חזרה למעלה</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>יצירת קשר</h4>
        <ul>
          <li><a id="footTel" href="tel:">טלפון</a></li>
          <li><a id="footWa" href="#">וואטסאפ</a></li>
          <li><a id="footMap" href="#">ניווט לכתובת</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bot">
      <span id="footLegal">כל הזכויות שמורות</span>
      <a class="up" href="#top">חזרה למעלה <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
    </div>
    <div class="foot-word" id="footWord" aria-hidden="true">OBSIDIAN</div>
  </div>
</footer>

<!-- ================= DOTS ================= -->
<div class="dots" id="dots" aria-label="ניווט מהיר"></div>

<!-- ================= DOCK ================= -->
<div class="dock">
  <div class="dock-card" id="dockCard" role="dialog" aria-label="צ׳אט בוואטסאפ">
    <div class="dc-head">
      <span class="dc-av" id="dcAv">א</span>
      <div>
        <b id="dcName">העסק שלכם</b>
        <i>● מחובר · מענה מהיר</i>
      </div>
    </div>
    <div class="dc-body">
      <p class="dc-msg" id="dcMsg">היי! רוצים לשמוע פרטים? כתבו לנו ונחזור אליכם מיד.<small id="dcTime">עכשיו</small></p>
      <a class="btn btn-primary" id="dockWa" href="#">פתיחת שיחה</a>
      <a class="dc-call" id="dockCall" href="tel:">או פשוט להתקשר</a>
    </div>
  </div>
  <button class="dock-fab" id="dockFab" type="button" aria-label="פתיחת צ׳אט בוואטסאפ" aria-expanded="false" aria-controls="dockCard">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.15a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 01-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 015.83 2.42 8.19 8.19 0 012.41 5.83c0 4.54-3.7 8.23-8.25 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.02s.87 2.34.99 2.5c.12.17 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.46-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
  </button>
</div>

<div class="mbar" id="mbar">
  <a class="btn btn-primary" id="mWa" href="#">וואטסאפ</a>
  <a class="btn btn-ghost" id="mCall" href="tel:">התקשרו</a>
</div>

<!-- ================= LIGHTBOX ================= -->
<div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="תצוגת תמונה" aria-hidden="true">
  <div class="lb-bar">
    <span class="cnt"><b id="lbNow">01</b> / <span id="lbTotal">03</span></span>
    <button class="lb-close" id="lbClose" type="button" aria-label="סגירה">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="lb-stage">
    <button class="lb-nav lb-prev" id="lbPrev" type="button" aria-label="הקודם">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <img id="lbImg" src="" alt="">
    <button class="lb-nav lb-next" id="lbNext" type="button" aria-label="הבא">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
  </div>
  <div class="lb-cap"><b id="lbCapT"></b><span id="lbCapD"></span></div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
  <span id="toastTxt">הועתק</span>
</div>
