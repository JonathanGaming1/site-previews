<script>
var siteData = __SITE_DATA_JSON__;
(function () {
  "use strict";
  var doc = document, root = doc.documentElement;
  var D = (siteData && typeof siteData === "object") ? siteData : {};
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function $(s, c) { return (c || doc).querySelector(s); }
  function $$(s, c) { return Array.prototype.slice.call((c || doc).querySelectorAll(s)); }
  function el(t, c) { var n = doc.createElement(t); if (c) n.className = c; return n; }
  function txt(n, v) { if (n) n.textContent = (v == null ? "" : String(v)); }
  function pick() { for (var i = 0; i < arguments.length; i++) { var v = arguments[i]; if (v !== undefined && v !== null && String(v).trim() !== "") return v; } return ""; }
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function cut(s, n) { s = String(s || ""); return s.length > n ? s.slice(0, n - 1).replace(/\s+\S*$/, "") + "…" : s; }
  function arr(v) { return Array.isArray(v) ? v : []; }

  /* ---------------- data ---------------- */
  var FB = {
    name: "העסק שלכם",
    category: "עסק מקומי",
    city: "תל אביב והמרכז",
    headline: "חוויית לקוח",
    accentWord: "מהשורה הראשונה",
    kicker: "אנחנו כאן בשבילכם",
    sub: "אנחנו עובדים ברמה של מותג גדול — עם תשומת לב לפרט, זמני תגובה קצרים ותוצאה שנראית מצוין בכל מסך.",
    aboutTitle: "הכל מתחיל באנשים",
    about: "אנחנו מאמינים שעבודה טובה לא צריכה להיות מסובכת. מקשיבים, מתכננים בקפידה ומבצעים בזמן — עם יחס אישי בכל שלב.",
    servicesTitle: "מה אנחנו עושים",
    servicesIntro: "שלושה מסלולים שנבנו כדי להתאים בדיוק למה שאתם צריכים — בלי יותר ובלי פחות.",
    workTitle: "עבודות נבחרות",
    workIntro: "מדגם מתוך פרויקטים אחרונים. לחיצה על תמונה פותחת אותה בגודל מלא.",
    processTitle: "שלושה שלבים, אפס הפתעות",
    faqTitle: "שאלות נפוצות",
    ctaTitle: "בואו נדבר על הפרויקט שלכם",
    ctaText: "ספרו לנו מה אתם צריכים. נחזור אליכם עם כיוון ראשוני והערכה — בלי התחייבות.",
    cta: "דברו איתנו"
  };

  var name = String(pick(D.businessName, D.name, D.brandName, D.companyName, FB.name));
  var category = String(pick(D.category, D.niche, D.profession, FB.category));
  var city = String(pick(D.city, D.area, D.region, FB.city));
  var kicker = String(pick(D.kicker, D.tagline, D.slogan, FB.kicker));
  var headline = String(pick(D.headline, D.heroTitle, D.title, FB.headline));
  var accentWord = String(pick(D.futureHeadlineAccent, D.headlineAccent, D.accentWord, FB.accentWord));
  var sub = String(pick(D.subheadline, D.subtitle, D.heroSubtitle, FB.sub));
  var visualLabel = String(pick(D.futureVisualLabel, D.visualLabel, "פרויקט נבחר"));
  var heroImage = String(pick(D.heroImageUrl, D.heroImage, D.image, D.coverImage));
  var aboutImage = String(pick(D.aboutImage, D.aboutImageUrl, heroImage));
  var aboutTitle = String(pick(D.aboutTitle, FB.aboutTitle));
  var about = String(pick(D.about, D.aboutText, D.description, FB.about));
  var servicesTitle = String(pick(D.servicesTitle, FB.servicesTitle));
  var servicesIntro = String(pick(D.servicesIntro, D.servicesSubtitle, FB.servicesIntro));
  var workTitle = String(pick(D.workTitle, D.galleryTitle, FB.workTitle));
  var workIntro = String(pick(D.workIntro, D.galleryIntro, FB.workIntro));
  var processTitle = String(pick(D.processTitle, FB.processTitle));
  var faqTitle = String(pick(D.faqTitle, FB.faqTitle));
  var ctaTitle = String(pick(D.contactTitle, D.ctaTitle, FB.ctaTitle));
  var ctaText = String(pick(D.contactText, D.ctaText, FB.ctaText));
  var ctaLabel = String(pick(D.ctaText, D.buttonText, FB.cta));
  if (/^(נסו|התחילו|קבלו|דברו)/.test(ctaLabel) === false && ctaLabel.length > 26) ctaLabel = FB.cta;
  var address = String(pick(D.fullAddress, D.address, D.street, city));
  var phone = String(pick(D.phone, D.telephone, D.phoneNumber));
  var ratingInfo = String(pick(D.ratingInfo));

  var telHref = String(pick(D.phoneHref, D.phoneLink));
  if (!telHref && phone) {
    var pd = phone.replace(/[^\d+]/g, "");
    if (pd.charAt(0) === "0") pd = "+972" + pd.slice(1);
    if (pd) telHref = "tel:" + pd;
  }
  var waHref = String(pick(D.whatsappUrl, D.whatsapp, D.waLink));
  if (!waHref && phone) {
    var wd = phone.replace(/[^\d]/g, "");
    if (wd.charAt(0) === "0") wd = "972" + wd.slice(1);
    if (wd) waHref = "https://wa.me/" + wd;
  }
  var mapsHref = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(address || city || name);
  var letter = String(pick(D.logoText, D.initial, name.charAt(0) || "א")).trim().slice(0, 2) || "א";

  var rating = parseFloat(pick(D.rating, D.stars, D.googleRating));
  if (isNaN(rating) || rating <= 0 || rating > 5) rating = 0;
  var rcount = parseInt(pick(D.ratingCount, D.reviews, D.reviewsCount), 10);
  if (isNaN(rcount) || rcount < 0) rcount = 0;

  /* ---------------- theme ---------------- */
  function hexRgb(h) {
    h = String(h || "").trim();
    if (/^#?[0-9a-fA-F]{3}$/.test(h)) { var t = h.replace("#", ""); h = "#" + t.charAt(0) + t.charAt(0) + t.charAt(1) + t.charAt(1) + t.charAt(2) + t.charAt(2); }
    var m = /^#?([0-9a-fA-F]{6})$/.exec(h);
    if (!m) return null;
    var n = parseInt(m[1], 16);
    return [n >> 16 & 255, n >> 8 & 255, n & 255];
  }
  function rgbHsl(c) {
    var r = c[0] / 255, g = c[1] / 255, b = c[2] / 255;
    var mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn, h = 0, s = 0, l = (mx + mn) / 2;
    if (d) {
      s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn);
      if (mx === r) h = (g - b) / d + (g < b ? 6 : 0);
      else if (mx === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h *= 60;
    }
    return [h, s, l];
  }
  function hslHex(h, s, l) {
    h = ((h % 360) + 360) % 360;
    function f(n) {
      var k = (n + h / 30) % 12, a = s * Math.min(l, 1 - l);
      return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))));
    }
    var c = [f(0), f(8), f(4)];
    return "#" + c.map(function (v) { return ("0" + v.toString(16)).slice(-2); }).join("");
  }
  function lum(c) {
    var a = c.map(function (v) { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); });
    return 0.2126 * a[0] + 0.7152 * a[1] + 0.0722 * a[2];
  }
  var accentRgb = hexRgb(pick(D.accentColor, D.accent, D.primaryColor, "#8b7cff")) || [139, 124, 255];
  var accent = "#" + accentRgb.map(function (v) { return ("0" + v.toString(16)).slice(-2); }).join("");
  var hsl = rgbHsl(accentRgb);
  var accent2 = hslHex(hsl[0] + 42, Math.min(0.85, Math.max(0.45, hsl[1])), Math.min(0.72, Math.max(0.42, hsl[2])));
  function ratio(a, b) { var hi = Math.max(a, b), lo = Math.min(a, b); return (hi + 0.05) / (lo + 0.05); }
  var la = lum(accentRgb), ldark = lum([7, 8, 12]);
  var btnFg = ratio(la, 1) >= ratio(la, ldark) ? "#ffffff" : "#07080c";
  root.style.setProperty("--accent", accent);
  root.style.setProperty("--accent-color", accent);
  root.style.setProperty("--accent-rgb", accentRgb.join(", "));
  root.style.setProperty("--accent-2", accent2);
  root.style.setProperty("--btn-fg", btnFg);

  /* ---------------- head / meta ---------------- */
  var title = name + (category ? " — " + category : "") + (city ? " · " + city : "");
  doc.title = title;
  var desc = cut(sub || about, 158);
  ["metaDesc", "ogDesc"].forEach(function (id) { var n = doc.getElementById(id); if (n) n.setAttribute("content", desc); });
  var ogt = doc.getElementById("ogTitle"); if (ogt) ogt.setAttribute("content", title);
  var ogi = doc.getElementById("ogImage"); if (ogi && heroImage) ogi.setAttribute("content", heroImage);
  var tc = doc.getElementById("themeColor"); if (tc) tc.setAttribute("content", "#06070b");
  var fav = doc.getElementById("favicon");
  if (fav) {
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="' + accent + '"/><text x="32" y="44" font-size="34" font-family="Heebo,Arial,sans-serif" font-weight="700" text-anchor="middle" fill="' + btn Fg + '">' + esc(letter) + "</text></svg>";
    fav.setAttribute("href", "data:image/svg+xml," + encodeURIComponent(svg));
  }

  /* ---------------- small renderers ---------------- */
  function setGrad(node, value, fallback) {
    if (!node) return;
    var t = String(value || fallback || "").trim();
    var bits = t.split(/\s+/);
    if (bits.length < 2) { node.innerHTML = esc(t); return; }
    var last = bits.pop();
    node.innerHTML = esc(bits.join(" ")) + ' <span class="grad">' + esc(last) + "</span>";
  }
  var STAR = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 6.1 6.7.9-4.9 4.6 1.2 6.6L12 17.7 6.1 20.8l1.2-6.6L2.4 9.6l6.7-.9z"/></svg>';
  function fillStars(node, n) {
    if (!node) return;
    var k = Math.round(n), out = "";
    for (var i = 0; i < 5; i++) out += '<span style="opacity:' + (i < k ? 1 : 0.22) + '">' + STAR + "</span>";
    node.innerHTML = out;
  }

  /* ---------------- brand + contact wiring ---------------- */
  $$("[data-t]").forEach(function (n) {
    var k = n.getAttribute("data-t");
    if (k === "businessName") txt(n, name);
    else if (k === "category") txt(n, category);
    else if (k === "city") txt(n, city);
  });
  ["brandMark", "footMark", "dcAv"].forEach(function (id) { txt(doc.getElementById(id), letter); });
  txt($("#brandMark"), letter);
  var brandName = $("#brandName"); if (brandName) txt(brandName, name);

  var telEls = ["navCall", "menuCall", "footTel", "telBtn", "telRow", "dockCall", "mCall", "contactCall"];
  telEls.forEach(function (id) { var n = doc.getElementById(id); if (n) n.setAttribute("href", telHref || "#contact"); });
  var waEls = ["waBtn", "dockWa", "faqWa", "footWa", "mWa"];
  waEls.forEach(function (id) { var n = doc.getElementById(id); if (n) n.setAttribute("href", waHref || telHref || "#contact"); });
  ["navCall", "menuCall"].forEach(function (id) { var n = doc.getElementById(id); if (n && phone) txt(n, "התקשרו"); });
  var telRow = doc.getElementById("telRow"); if (telRow) telRow.setAttribute("href", telHref || "#contact");
  var addrRow = doc.getElementById("addrRow"); if (addrRow) addrRow.setAttribute("href", mapsHref);
  var footMap = doc.getElementById("footMap"); if (footMap) footMap.setAttribute("href", mapsHref);
  txt(doc.getElementById("telText"), phone || "דברו איתנו");
  txt(doc.getElementById("contactAddr"), address || city || "ישראל");
  txt(doc.getElementById("dcName"), name);
  txt(doc.getElementById("dcMsg"), "היי! כאן " + name + ". רוצים לשמוע פרטים? כתבו לנו ונחזור אליכם מיד.");
  var dcTime = doc.getElementById("dcTime");
  if (dcTime) {
    var dnow = new Date();
    dcTime.textContent = ("0" + dnow.getHours()).slice(-2) + ":" + ("0" + dnow.getMinutes()).slice(-2);
  }
  var navCta = doc.getElementById("navCta"); if (navCta) txt(navCta, cut(ctaLabel, 22));
  txt(doc.getElementById("heroPrimary"), cut(ctaLabel, 24));
  var menuCta = doc.getElementById("menuCta"); if (menuCta) txt(menuCta, cut(ctaLabel, 22));
  var mobileWa = doc.getElementById("mWa"); if (mobileWa) txt(mobileWa, "וואטסאפ");
  var pv = doc.getElementById("previewNote"); if (pv) pv.hidden = !D.isPreview;

  /* ---------------- hero ---------------- */
  var hero = doc.getElementById("top");
  txt(doc.getElementById("heroBadge"), cut(category, 26) || "עסק מקומי");
  txt(doc.getElementById("heroKicker"), kicker);
  txt(doc.getElementById("hl1"), headline);
  txt(doc.getElementById("hl2"), accentWord);
  txt(doc.getElementById("heroSub"), sub);
  txt(doc.getElementById("metaCity"), city);
  txt(doc.getElementById("metaCat"), category);
  txt(doc.getElementById("hmTopSmall"), cut(visualLabel, 22));
  txt(doc.getElementById("hmTopText"), name);
  txt(doc.getElementById("hmBotSmall"), "מיקום");
  txt(doc.getElementById("hmBotText"), city);
  var heroGhost = doc.getElementById("heroGhost");
  if (heroGhost) txt(heroGhost, "לעבודות שלנו");

  var heroImg = doc.getElementById("heroImg");
  var heroShot = doc.getElementById("heroShot");
  if (heroImage && heroImg) {
    heroImg.src = heroImage;
    heroImg.alt = name + " — " + category;
    heroImg.addEventListener("error", function () { heroShot.classList.add("noimg"); heroImg.style.display = "none"; });
  } else if (heroShot) {
    heroShot.className += " noimg";
    if (heroImg) heroImg.style.display = "none";
  }

  if (rating > 0) {
    var rc = doc.getElementById("rateChip");
    if (rc) rc.hidden = false;
    var rd = doc.getElementById("rateDot"); if (rd) rd.hidden = false;
    txt(doc.getElementById("rateVal"), rating.toFixed(1));
    fillStars(doc.getElementById("rateStars"), rating);
    txt(doc.getElementById("rateCount"), ratingInfo || (rcount ? rcount + " ביקורות בגוגל" : "ביקורות בגוגל"));
    var rb = doc.getElementById("rateBig");
    if (rb) rb.innerHTML = rating.toFixed(1) + "<sup>★</sup>";
    txt(doc.getElementById("rateSmall"), ratingInfo || (rcount ? "מבוסס על " + rcount + " ביקורות" : "מבוסס על ביקורות אמיתיות"));
    fillStars(doc.getElementById("rateStars2"), rating);
  } else {
    var rcard = doc.getElementById("rateCard");
    if (rcard) {
      var eyebrow = rcard.querySelector(".eyebrow"); if (eyebrow) txt(eyebrow, "מיקום");
      var big = doc.getElementById("rateBig");
      if (big) { big.innerHTML = esc(city || "ישראל"); if (city.length > 9) big.style.fontSize = "clamp(20px,2.3vw,28px)"; }
      var small = doc.getElementById("rateSmall");
      if (small) small.textContent = "אזור השירות שלנו";
      var st2 = doc.getElementById("rateStars2"); if (st2) st2.style.display = "none";
    }
  }

  setGrad(doc.getElementById("svcTitle"), servicesTitle, FB.servicesTitle);
  txt(doc.getElementById("svcIntro"), servicesIntro);
  setGrad(doc.getElementById("aboutTitle"), aboutTitle, FB.aboutTitle);
  setGrad(doc.getElementById("workTitle"), workTitle, FB.workTitle);
  txt(doc.getElementById("workIntro"), workIntro);
  setGrad(doc.getElementById("procTitle"), processTitle, FB.processTitle);
  setGrad(doc.getElementById("faqTitle"), faqTitle, FB.faqTitle);
  txt(doc.getElementById("aboutHead"), aboutTitle);
  txt(doc.getElementById("aboutText"), about);
  var abd = doc.getElementById("aboutImg");
  if (abd && aboutImage) { abd.src = aboutImage; abd.alt = name; }
  else if (abd) { abd.style.display = "none"; }

  /* ---------------- stats ---------------- */
  var statVal = parseInt(pick(D.projectsCount, D.clientsCount, D.yearsExperience, "120"), 10);
  if (isNaN(statVal) || statVal < 0) statVal = 120;
  var statEl = doc.getElementById("statNum");
  if (statEl) statEl.setAttribute("data-count", String(statVal));
  txt(doc.getElementById("statLabel"), String(pick(D.statLabel, "פרויקטים שהושלמו בשנה האחרונה")));

  /* ---------------- services ---------------- */
  var svcFallback = [
    { title: "תכנון ואפיון", description: "מתחילים מהבנת הצורך, מגדירים מטרות ומתרגמים אותן לתוכנית עבודה מדויקת עם לוחות זמנים." },
    { title: "ביצוע וליווי", description: "מובילים את הפרויקט מהתחלה ועד הסוף, עם עדכונים שוטפים ופיקוח על כל פרט." },
    { title: "שירות ושיפור", description: "נשארים איתכם גם אחרי המסירה — מתחזקים, משפרים ומגיבים מהר לכל צורך." }
  ];
  var services = [];
  arr(D.services).forEach(function (s) {
    if (!s) return;
    if (typeof s === "string") { if (s.trim()) services.push({ title: s.trim(), description: "" }); return; }
    var t = String(pick(s.title, s.name, s.label, s.heading));
    if (!t) return;
    services.push({ title: t, description: String(pick(s.description, s.desc, s.text, s.body)) });
  });
  if (!services.length) services = svcFallback;
  services = services.slice(0, 5);

  var svcList = doc.getElementById("svcList");
  var visStack = doc.getElementById("visStack");
  var visDots = doc.getElementById("visDots");
  var ARROW = '<span class="svc-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></span>';
  services.forEach(function (s, i) {
    var n = i + 1, pad = "0" + n;
    var item = el("article", "svc-item" + (i === 0 ? " on" : ""));
    item.setAttribute("data-i", String(i));
    item.innerHTML = "<h3><i>" + pad + "</i>" + esc(s.title) + "</h3><p>" + esc(s.description) + "</p>" + ARROW;
    if (svcList) svcList.appendChild(item);

    var vis = el("div", "vis" + (i === 0 ? " on" : ""));
    vis.setAttribute("data-i", String(i));
    vis.innerHTML = '<span class="vis-tag">0' + pad + '</span><div class="vis-num">0' + pad + '</div><div class="vis-body"><b>' + esc(s.title) + "</b><p>" + esc(cut(s.description, 108)) + "</p></div>";
    if (visStack) visStack.appendChild(vis);

    if (visDots) { var d = el("i"); if (i === 0) d.className = "on"; visDots.appendChild(d); }
  });

  /* ---------------- gallery ---------------- */
  var gImgs = arr(D.galleryImages);
  var gTitles = arr(D.galleryTitles);
  var gDescs = arr(D.galleryDescriptions);
  var gallery = [];
  gImgs.forEach(function (g, i) {
    if (gallery.length >= 8) return;
    if (!g) return;
    var url = "", t = "", d = "";
    if (typeof g === "string") { url = g; }
    else { url = String(pick(g.url, g.image, g.src, g.href, g.imageUrl)); t = String(pick(g.title, g.name, g.label)); d = String(pick(g.description, g.desc, g.caption)); }
    if (!url) return;
    gallery.push({ url: url, title: t || String(pick(gTitles[i], "")), desc: d || String(pick(gDescs[i], "")) });
  });

  var workSec = doc.getElementById("work");
  var galTrack = doc.getElementById("galTrack");
  if (gallery.length) {
    if (workSec) workSec.style.height = (100 + Math.max(0, gallery.length - 1) * 58) + "vh";
    txt(doc.getElementById("galTotal"), "0" + gallery.length);
    gallery.forEach(function (g, i) {
      var card = el("button", "gcard");
      card.type = "button";
      card.setAttribute("data-i", String(i));
      card.setAttribute("aria-label", "פתיחת תמונה: " + (g.title || name));
      card.innerHTML = '<img src="' + esc(g.url) + '" alt="' + esc(g.title || name + " — עבודה " + (i + 1)) + '" loading="lazy" decoding="async">' +
        '<span class="gnum">0' + (i + 1) + "</span>" +
        '<span class="gcap"><b>' + esc(g.title) + "</b><span>" + esc(g.desc) + "</span></span>";
      if (galTrack) galTrack.appendChild(card);
      var im = card.querySelector("img");
      if (im) {
        var done = function () { im.classList.add("loaded"); };
        im.addEventListener("load", done);
        im.addEventListener("error", done);
        if (im.complete) done();
      }
    });
  } else if (workSec) {
    workSec.style.display = "none";
  }

  /* ---------------- process ---------------- */
  var steps = [];
  arr(D.processSteps).forEach(function (s) {
    if (!s) return;
    if (typeof s === "string") { if (s.trim()) steps.push({ title: s.trim(), description: "" }); return; }
    var t = String(pick(s.title, s.name, s.step, s.label));
    if (!t) return;
    steps.push({ title: t, description: String(pick(s.description, s.desc, s.text)) });
  });
  if (!steps.length) steps = [
    { title: "פגישה והיכרות", description: "מקשיבים, שואלים שאלות ומבינים בדיוק מה אתם צריכים ואיפה אתם נמצאים היום." },
    { title: "תכנון והצעה", description: "מגבשים תוכנית עבודה ברורה עם שלבים, לוחות זמנים ומחיר — בלי אותיות קטנות." },
    { title: "ביצוע ומסירה", description: "מבצעים, מעדכנים לאורך הדרך ומוסרים תוצאה מוכנה. נשארים זמינים גם אחרי." }
  ];
  var procList = doc.getElementById("procList");
  steps.slice(0, 4).forEach(function (s, i) {
    var st = el("div", "step");
    st.setAttribute("data-i", String(i));
    st.innerHTML = '<span class="node">0' + (i + 1) + "</span><h3>" + esc(s.title) + "</h3><p>" + esc(s.description) + "</p>";
    if (procList) procList.appendChild(st);
  });

  /* ---------------- faq ---------------- */
  var faqs = [];
  arr(D.faqs).forEach(function (f) {
    if (!f) return;
    var q = String(pick(f.question, f.q, f.title));
    var a = String(pick(f.answer, f.a, f.text, f.content));
    if (q) faqs.push({ q: q, a: a });
  });
  if (!faqs.length) faqs = [
    { q: "כמה זמן לוקח התהליך?", a: "רוב הפרויקטים מסתיימים בין שבוע לשלושה שבועות, בהתאם להיקף. כבר בשיחה הראשונה נקבל צפי מדויק." },
    { q: "מה כלול במחיר?", a: "כל מה שסיכמנו מראש — בלי הפתעות. תקבלו הצעה מפורטת וכתב כמויות לפני שמתחילים." },
    { q: "אפשר להתחיל בקטן?", a: "בהחלט. אפשר לבחור מסלול חלקי ולהרחיב אותו בהמשך, לפי מה שמתאים לכם." },
    { q: "איך יוצרים קשר?", a: "בהודעת וואטסאפ או בשיחה טלפונית — אנחנו עונים בדרך כלל באותו יום עסקים." }
  ];
  var accList = doc.getElementById("accList");
  faqs.slice(0, 8).forEach(function (f, i) {
    var item = el("div", "acc-item" + (i === 0 ? " open" : ""));
    var btn = el("button", "acc-btn");
    btn.type = "button";
    btn.setAttribute("aria-expanded", i === 0 ? "true" : "false");
    btn.innerHTML = "<span>" + esc(f.q) + '</span><span class="pm" aria-hidden="true"></span>';
    var panel = el("div", "acc-panel");
    panel.innerHTML = "<div><p>" + esc(f.a) + "</p></div>";
    item.appendChild(btn);
    item.appendChild(panel);
    if (accList) accList.appendChild(item);
  });

  /* ---------------- marquee ---------------- */
  function mqBuild(node, words, offset) {
    if (!node) return;
    var seq = "";
    words.forEach(function (w, i) {
      var inner = ((i + offset) % 2 === 1) ? "<i>" + esc(w) + "</i>" : esc(w);
      seq += "<span>" + inner + "<em></em></span>";
    });
    node.innerHTML = seq + seq;
  }
  var wordsA = services.map(function (s) { return s.title; });
  if (wordsA.length < 3) wordsA = wordsA.concat([category, city]);
  var wordsB = [city, name].concat(services.map(function (s) { return s.title; }));
  mqBuild(doc.getElementById("mqA"), wordsA, 0);
  mqBuild(doc.getElementById("mqB"), wordsB, 1);

  /* ---------------- cta ---------------- */
  var ct = doc.getElementById("ctaTitle");
  if (ct) {
    var bits = ctaTitle.trim().split(/\s+/);
    if (bits.length > 2) {
      var tail = bits.slice(-2).join(" ");
      ct.innerHTML = esc(bits.slice(0, -2).join(" ")) + " <b>" + esc(tail) + "</b>";
    } else {
      ct.innerHTML = esc(ctaTitle);
    }
  }
  txt(doc.getElementById("ctaText"), ctaText);
  var footBlurb = doc.getElementById("footBlurb");
  if (footBlurb) txt(footBlurb, cut(sub, 96));
  var footLegal = doc.getElementById("footLegal");
  if (footLegal) footLegal.textContent = "© " + new Date().getFullYear() + " " + name + ". כל הזכויות שמורות.";
  var footWord = doc.getElementById("footWord");
  if (footWord) footWord.textContent = name;

  /* ---------------- json-ld ---------------- */
  var ld = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: name,
    description: desc,
    areaServed: city,
    url: location.href
  };
  if (heroImage) ld.image = heroImage;
  if (phone) ld.telephone = phone;
  if (address) ld.address = { "@type": "PostalAddress", streetAddress: address, addressLocality: city, addressCountry: "IL" };
  if (rating > 0) ld.aggregateRating = { "@type": "AggregateRating", ratingValue: rating, reviewCount: rcount || 1, bestRating: 5 };
  var ldScript = doc.createElement("script");
  ldScript.type = "application/ld+json";
  ldScript.textContent = JSON.stringify(ld);
  doc.head.appendChild(ldScript);

  /* ---------------- dots nav ---------------- */
  var dotDefs = [
    { id: "top", label: "ראשי" },
    { id: "services", label: "שירותים" },
    { id: "about", label: "אודות" },
    { id: "work", label: "עבודות" },
    { id: "process", label: "תהליך" },
    { id: "faq", label: "שאלות" },
    { id: "contact", label: "צור קשר" }
  ];
  var dots = doc.getElementById("dots");
  dotDefs.forEach(function (d, i) {
    var sec = doc.getElementById(d.id);
    if (!sec || sec.style.display === "none") return;
    var b = el("button");
    b.type = "button";
    b.setAttribute("data-target", d.id);
    b.setAttribute("aria-label", d.label);
    b.innerHTML = "<i></i><b>" + esc(d.label) + "</b>";
    b.addEventListener("click", function () {
      var t = doc.getElementById(d.id);
      if (t) t.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    });
    if (dots) dots.appendChild(b);
  });
  var dotBtns = $$("#dots button");

  /* ---------------- reveal ---------------- */
  var revealEls = $$(".reveal, .reveal-x");
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
    revealEls.forEach(function (n) { io.observe(n); });

    var svcItems = $$(".svc-item");
    var visEls = $$(".vis");
    var dotEls = $$("#visDots i");
    var actIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var i = parseInt(e.target.getAttribute("data-i"), 10) || 0;
        svcItems.forEach(function (n, k) { n.classList.toggle("on", k === i); });
        visEls.forEach(function (n, k) { n.classList.toggle("on", k === i); });
        dotEls.forEach(function (n, k) { n.classList.toggle("on", k === i); });
      });
    }, { threshold: 0.55, rootMargin: "-18% 0px -32% 0px" });
    svcItems.forEach(function (n) { actIO.observe(n); });

    var stepsEls = $$(".step");
    var stepIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { e.target.classList.toggle("on", e.isIntersecting); });
    }, { threshold: 0.4, rootMargin: "-12% 0px -28% 0px" });
    stepsEls.forEach(function (n) { stepIO.observe(n); });

    var counter = doc.getElementById("statNum");
    if (counter) {
      var target = parseInt(counter.getAttribute("data-count"), 10) || 0;
      var cIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          cIO.unobserve(e.target);
          if (reduce) { counter.textContent = target.toLocaleString("he-IL"); return; }
          var t0 = 0;
          function tick(ts) {
            if (!t0) t0 = ts;
            var p = Math.min(1, (ts - t0) / 1400);
            var eased = 1 - Math.pow(1 - p, 3);
            counter.textContent = Math.round(target * eased).toLocaleString("he-IL");
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.5 });
      cIO.observe(counter);
    }

    var secIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var id = e.target.id;
        dotBtns.forEach(function (b) { b.classList.toggle("on", b.getAttribute("data-target") === id); });
      });
    }, { threshold: 0.01, rootMargin: "-45% 0px -50% 0px" });
    dotDefs.forEach(function (d) { var s = doc.getElementById(d.id); if (s) secIO.observe(s); });
  } else {
    revealEls.forEach(function (n) { n.classList.add("in"); });
  }
  requestAnimationFrame(function () { if (hero) hero.classList.add("in"); });

  /* ---------------- accordion ---------------- */
  $$(".acc-item").forEach(function (item) {
    var btn = item.querySelector(".acc-btn");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var open = item.classList.contains("open");
      $$(".acc-item").forEach(function (o) {
        o.classList.remove("open");
        var b = o.querySelector(".acc-btn"); if (b) b.setAttribute("aria-expanded", "false");
      });
      if (!open) { item.classList.add("open"); btn.setAttribute("aria-expanded", "true"); }
    });
  });

  /* ---------------- menu ---------------- */
  var burger = doc.getElementById("burger");
  var menu = doc.getElementById("menu");
  function setMenu(open) {
    if (!menu || !burger) return;
    menu.classList.toggle("open", open);
    menu.setAttribute("aria-hidden", open ? "false" : "true");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
    root.classList.toggle("lock", open);
    $$(".m-link", menu).forEach(function (a, i) { a.style.transitionDelay = open ? (0.06 + i * 0.045) + "s" : "0s"; });
  }
  if (burger) burger.addEventListener("click", function () { setMenu(!menu.classList.contains("open")); });
  if (menu) $$("a", menu).forEach(function (a) { a.addEventListener("click", function () { setMenu(false); }); });
  doc.addEventListener("keydown", function (e) { if (e.key === "Escape") setMenu(false); });

  /* ---------------- dock ---------------- */
  var dockFab = doc.getElementById("dockFab");
  var dockCard = doc.getElementById("dockCard");
  function setDock(open) {
    if (!dockCard || !dockFab) return;
    dockCard.classList.toggle("open", open);
    dockFab.setAttribute("aria-expanded", open ? "true" : "false");
  }
  if (dockFab) dockFab.addEventListener("click", function () { setDock(!dockCard.classList.contains("open")); });
  doc.addEventListener("click", function (e) {
    if (!dockCard || !dockFab) return;
    if (!dockCard.contains(e.target) && !dockFab.contains(e.target)) setDock(false);
  });

  /* ---------------- lightbox ---------------- */
  var lb = doc.getElementById("lightbox");
  var lbImg = doc.getElementById("lbImg");
  var lbCapT = doc.getElementById("lbCapT");
  var lbCapD = doc.getElementById("lbCapD");
  var lbNow = doc.getElementById("lbNow");
  var lbTotal = doc.getElementById("lbTotal");
  var lbIdx = 0, lastFocus = null;
  txt(lbTotal, "0" + gallery.length);
  function showLb(i) {
    if (!gallery.length) return;
    lbIdx = (i + gallery.length) % gallery.length;
    var g = gallery[lbIdx];
    if (lbImg) { lbImg.src = g.url; lbImg.alt = g.title || name; }
    txt(lbCapT, g.title || "");
    txt(lbCapD, g.desc || "");
    txt(lbNow, "0" + (lbIdx + 1));
  }
  function openLb(i) {
    if (!lb) return;
    lastFocus = doc.activeElement;
    showLb(i);
    lb.classList.add("open");
    lb.setAttribute("aria-hidden", "false");
    root.classList.add("lock");
    var c = doc.getElementById("lbClose"); if (c) c.focus();
  }
  function closeLb() {
    if (!lb) return;
    lb.classList.remove("open");
    lb.setAttribute("aria-hidden", "true");
    root.classList.remove("lock");
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  $$(".gcard").forEach(function (c) {
    c.addEventListener("click", function () { openLb(parseInt(c.getAttribute("data-i"), 10) || 0); });
  });
  var lbClose = doc.getElementById("lbClose");
  if (lbClose) lbClose.addEventListener("click", closeLb);
  var lbPrev = doc.getElementById("lbPrev");
  if (lbPrev) lbPrev.addEventListener("click", function () { showLb(lbIdx - 1); });
  var lbNext = doc.getElementById("lbNext");
  if (lbNext) lbNext.addEventListener("click", function () { showLb(lbIdx + 1); });
  if (lb) lb.addEventListener("click", function (e) { if (e.target === lb) closeLb(); });
  doc.addEventListener("keydown", function (e) {
    if (!lb || !lb.classList.contains("open")) return;
    if (e.key === "Escape") closeLb();
    else if (e.key === "ArrowLeft") showLb(lbIdx + 1);
    else if (e.key === "ArrowRight") showLb(lbIdx - 1);
  });

  /* ---------------- copy phone ---------------- */
  var toast = doc.getElementById("toast");
  var toastTxt = doc.getElementById("toastTxt");
  var toastTimer = null;
  function toastShow(msg) {
    if (!toast) return;
    if (toastTxt) toastTxt.textContent = msg;
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.remove("show"); }, 2100);
  }
  var copyBtn = doc.getElementById("copyPhone");
  if (copyBtn) copyBtn.addEventListener("click", function (e) {
    e.preventDefault();
    e.stopPropagation();
    var v = phone || "";
    if (!v) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(v).then(function () { toastShow("מספר הטלפון הועתק"); }, function () { toastShow(v); });
    } else {
      var ta = doc.createElement("textarea");
      ta.value = v; doc.body.appendChild(ta); ta.select();
      try { doc.execCommand("copy"); toastShow("מספר הטלפון הועתק"); } catch (err) { toastShow(v); }
      doc.body.removeChild(ta);
    }
  });

  /* ---------------- pointer effects ---------------- */
  var fine = window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (fine && !reduce) {
    var cur = doc.getElementById("cur");
    var ring = doc.getElementById("curRing");
    var mx = 0, my = 0, rx = 0, ry = 0, started = false;
    doc.addEventListener("pointermove", function (e) {
      mx = e.clientX; my = e.clientY;
      if (!started) { started = true; rx = mx; ry = my; doc.body.classList.add("cur-on"); }
      if (cur) cur.style.transform = "translate3d(" + mx + "px," + my + "px,0)";
      var spot = doc.getElementById("bgSpot");
      if (spot) {
        spot.style.setProperty("--px", (mx / window.innerWidth * 100) + "%");
        spot.style.setProperty("--py", (my / window.innerHeight * 100) + "%");
      }
    }, { passive: true });
    (function loop() {
      rx += (mx - rx) * 0.18; ry += (my - ry) * 0.18;
      if (ring) ring.style.transform = "translate3d(" + rx + "px," + ry + "px,0)";
      requestAnimationFrame(loop);
    })();
    $$("a, button, .gcard").forEach(function (n) {
      n.addEventListener("pointerenter", function () { if (ring) ring.classList.add("hot"); });
      n.addEventListener("pointerleave", function () { if (ring) ring.classList.remove("hot"); });
    });

    $$(".magnet").forEach(function (b) {
      b.addEventListener("pointermove", function (e) {
        var r = b.getBoundingClientRect();
        var dx = (e.clientX - (r.left + r.width / 2)) / r.width;
        var dy = (e.clientY - (r.top + r.height / 2)) / r.height;
        b.style.transform = "translate3d(" + (dx * 7).toFixed(2) + "px," + (dy * 6 - 2).toFixed(2) + "px,0)";
      });
      b.addEventListener("pointerleave", function () { b.style.transform = ""; });
    });

    $$(".spot").forEach(function (c) {
      c.addEventListener("pointermove", function (e) {
        var r = c.getBoundingClientRect();
        c.style.setProperty("--mx", ((e.clientX - r.left) / r.width * 100).toFixed(1) + "%");
        c.style.setProperty("--my", ((e.clientY - r.top) / r.height * 100).toFixed(1) + "%");
      });
    });
  }

  /* ---------------- scroll engine ---------------- */
  var nav = doc.getElementById("nav");
  var progress = doc.getElementById("progressBar");
  var heroMedia = doc.getElementById("heroMedia");
  var galView = doc.getElementById("galView");
  var galFill = doc.getElementById("galFill");
  var galNow = doc.getElementById("galNow");
  var procFill = doc.getElementById("procFill");
  var mbar = doc.getElementById("mbar");
  var ticking = false;

  function onScroll() {
    var y = window.pageYOffset || root.scrollTop || 0;
    var h = Math.max(1, doc.body.scrollHeight - window.innerHeight);
    var p = Math.min(1, Math.max(0, y / h));

    if (progress) progress.style.scale = p + " 1";
    if (nav) nav.classList.toggle("scrolled", y > 24);
    if (mbar) mbar.classList.toggle("show", y > 260);
    if (heroMedia && !reduce && y < window.innerHeight * 1.2) {
      heroMedia.style.setProperty("--rx", (Math.min(y, 600) * 0.008).toFixed(2) + "deg");
      var im = heroMedia.querySelector("img");
      if (im) im.style.transform = "translate3d(0," + (y * 0.055).toFixed(1) + "px,0)";
    }

    if (gallery.length > 1 && galView && galTrack && workSec && !reduce && window.innerWidth > 860) {
      var r = workSec.getBoundingClientRect();
      var total = workSec.offsetHeight - window.innerHeight;
      var gp = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      var max = Math.max(0, galTrack.scrollWidth - galView.clientWidth);
      galTrack.style.transform = "translate3d(" + (gp * max).toFixed(1) + "px,0,0)";
      if (galFill) galFill.style.scale = gp + " 1";
      if (galNow) galNow.textContent = "0" + (Math.min(gallery.length, Math.round(gp * (gallery.length - 1)) + 1));
    }

    var proc = doc.getElementById("process");
    if (procFill && proc) {
      var pr = proc.getBoundingClientRect();
      var pp = Math.min(1, Math.max(0, (window.innerHeight * 0.78 - pr.top) / (pr.height * 0.9)));
      procFill.style.scale = (window.innerWidth <= 900 ? "1 " : "") + pp;
    }
    ticking = false;
  }
  function reqScroll() {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }
  window.addEventListener("scroll", reqScroll, { passive: true });
  window.addEventListener("resize", reqScroll);
  onScroll();
})();
</script>
</body>
</html>
